# ==============================================================================
# Environment Configuration Template for SIH26100 GeM Platform
# DO NOT COMMIT THE ACTUAL API KEY TO SOURCE CONTROL.
# Copy this file to .env and insert your real Gemini API key below.
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# ==============================================================================
# DigiLocker / API Setu Sandbox Integration Configuration
# Official Sandbox portal: https://sandbox.api-setu.in/
# ==============================================================================
DIGILOCKER_ENABLED=false
DIGILOCKER_ENV=sandbox
DIGILOCKER_CLIENT_ID=your_api_setu_sandbox_client_id_here
DIGILOCKER_CLIENT_SECRET=your_api_setu_sandbox_client_secret_here
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/v1/integrations/digilocker/callback
DIGILOCKER_BASE_URL=https://sandbox.api-setu.in
DIGILOCKER_TIMEOUT_SECONDS=30

# ==============================================================================
# API Setu / Income Tax Department PAN Verification Sandbox Configuration
# Official Sandbox portal: https://sandbox.api-setu.in/api-collection/pan/2
# Endpoint: POST /certificate/v3/pan/pancr
# ==============================================================================
PAN_VERIFICATION_ENABLED=false
PAN_VERIFICATION_ENV=sandbox
PAN_VERIFICATION_BASE_URL=https://sandbox.api-setu.in
PAN_VERIFICATION_API_KEY=
PAN_VERIFICATION_CLIENT_ID=in.gov.sandbox
PAN_VERIFICATION_TIMEOUT_SECONDS=10

# ==============================================================================
# API Setu / Ministry of MSME Udyam Certificate Sandbox Configuration
# Official Sandbox portal: https://sandbox.api-setu.in/api-collection/msme/1
# Endpoint: POST /certificate/v3/msme/udcer
# ==============================================================================
UDYAM_VERIFICATION_ENABLED=false
UDYAM_VERIFICATION_ENV=sandbox
UDYAM_VERIFICATION_BASE_URL=https://sandbox.api-setu.in
UDYAM_VERIFICATION_API_KEY=
UDYAM_VERIFICATION_CLIENT_ID=in.gov.sandbox
UDYAM_VERIFICATION_TIMEOUT_SECONDS=10

# ==============================================================================
# API Setu / Employees' Provident Fund Organisation (EPFO) Sandbox Configuration
# Official Sandbox portal: https://sandbox.api-setu.in/api-collection/epfindia/2
# Endpoints:
# - UAN Card: POST /certificate/v3/epfindia/uncrd
# - Scheme Certificate: POST /certificate/v3/epfindia/epfsc
# - Pension Certificate: POST /certificate/v3/epfindia/pecer
# ==============================================================================
EPFO_VERIFICATION_ENABLED=false
EPFO_VERIFICATION_ENV=sandbox
EPFO_VERIFICATION_BASE_URL=https://sandbox.api-setu.in
EPFO_VERIFICATION_API_KEY=
EPFO_VERIFICATION_CLIENT_ID=in.gov.sandbox
# ==============================================================================
# API Setu / Department for Promotion of Industry and Internal Trade (DPIIT) Sandbox Configuration
# Official Sandbox portal: https://sandbox.api-setu.in/
# Endpoint: POST /certificate/v3/dpiit/suirc
# ==============================================================================
DPIIT_VERIFICATION_ENABLED=false
DPIIT_VERIFICATION_ENV=sandbox
DPIIT_VERIFICATION_BASE_URL=https://sandbox.api-setu.in
DPIIT_VERIFICATION_API_KEY=
DPIIT_VERIFICATION_CLIENT_ID=in.gov.sandbox
DPIIT_VERIFICATION_TIMEOUT_SECONDS=10

# ==============================================================================
# API Setu / Employees' State Insurance Corporation (ESIC) Sandbox Configuration
# Official Sandbox portal: https://sandbox.api-setu.in/
# Endpoints:
# - Health Passbook: POST /certificate/v3/esic/esich
# - Pehchan Card: POST /certificate/v3/esic/phcrd
# ==============================================================================
ESIC_VERIFICATION_ENABLED=false
ESIC_VERIFICATION_ENV=sandbox
ESIC_VERIFICATION_BASE_URL=https://sandbox.api-setu.in
ESIC_VERIFICATION_API_KEY=
ESIC_VERIFICATION_CLIENT_ID=in.gov.sandbox
ESIC_VERIFICATION_TIMEOUT_SECONDS=10
